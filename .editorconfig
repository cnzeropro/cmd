# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 批处理脚本必须 CRLF，否则 cmd.exe 下执行异常（与 .gitattributes 一致）
[*.{cmd,bat}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{ps1,py}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
